{
	"schemaVersion": 1,
	"id": "nei",
	"version": "${version}",
	"name": "MaEMI (Fabric)",
	"description": "NEI-style autocrafting, tool-aware recipe matching and extra tooltips, bolted onto EMI for Minecraft 1.20.1.",
	"authors": ["MaEMI-Fabric contributors"],
	"license": "LGPL-3.0-or-later",
	"environment": "client",
	"entrypoints": {
		"client": ["dev.nei.fabric.NeiFabric"],
		"modmenu": ["dev.nei.fabric.NeiModMenu"],
		"emi": ["dev.nei.compat.emi.NeiEmiPlugin"]
	},
	"mixins": ["nei.mixins.json"],
	"depends": {
		"fabricloader": ">=0.15.0",
		"minecraft": "~1.20.1",
		"java": ">=17",
		"fabric-api": "*",
		"emi": ">=1.1.20"
	},
	"recommends": {
		"cloth-config": ">=11.0.0",
		"modmenu": ">=7.0.0"
	}
}