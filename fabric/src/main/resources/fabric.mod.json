{
	"schemaVersion": 1,
	"id": "nei",
	"version": "${version}",
	"name": "MaEMI (Fabric)",
	"description": "NEI-style autocrafting, tool-aware recipe matching and extra tooltips, bolted onto EMI for Minecraft 1.18.2.",
	"authors": ["MaEMI contributors"],
	"license": "LGPL-3.0-or-later",
	"environment": "client",
	"entrypoints": {
		"client": ["dev.nei.fabric.NeiFabric"],
		"modmenu": ["dev.nei.fabric.NeiModMenu"],
		"emi": ["dev.nei.compat.emi.NeiEmiPlugin"]
	},
	"mixins": ["nei.mixins.json"],
	"depends": {
		"fabricloader": ">=0.15.0",
		"minecraft": "~1.18.2",
		"java": ">=17",
		"fabric-api": "*",
		"emi": ">=0.7.3"
	},
	"recommends": {
		"cloth-config": ">=6.5.0",
		"modmenu": ">=3.2.0"
	}
}