{
	"schemaVersion": 1,
	"id": "nei",
	"version": "${version}",
	"name": "MaEMI (Fabric)",
	"description": "NEI-style autocrafting, tool-aware recipe matching and extra tooltips, bolted onto EMI for Minecraft 1.20.6.",
	"authors": [
		"MaEMI contributors"
	],
	"license": "LGPL-3.0-or-later",
	"environment": "client",
	"entrypoints": {
		"client": [
			"dev.nei.fabric.NeiFabric"
		],
		"modmenu": [
			"dev.nei.fabric.NeiModMenu"
		],
		"emi": [
			"dev.nei.compat.emi.NeiEmiPlugin"
		]
	},
	"mixins": [
		"nei.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.15.0",
		"minecraft": "~1.20.6",
		"java": ">=21",
		"fabric-api": "*",
		"emi": ">=1.1.22"
	},
	"recommends": {
		"cloth-config": ">=14.0.0",
		"modmenu": ">=10.0.0"
	}
}
